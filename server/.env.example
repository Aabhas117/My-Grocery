PORT=4000

MONGODB_URI=your_mongodb_connection_string_here

JWT_SECRET=your_super_strong_secret_key_here

NODE_ENV=development


CLOUDINARY_API_NAME=your_clodinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

STRIPE_PUBLISH_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

CPP_HOST=127.0.0.1
CPP_PORT=18080

# Seller Invite Code (for POST /api/seller/register)
# SELLER_INVITE_CODE=your_secure_seller_invite_code

# One-time initialization script variables (npm run init:seller)
# SELLER_INIT_EMAIL=seller@example.com
# SELLER_INIT_PASSWORD=your_secure_seller_password